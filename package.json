{
  "name": "martech-discovery-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/export-catalog.mjs && next dev --port 3000",
    "build": "node scripts/export-catalog.mjs && next build",
    "preview": "node scripts/export-catalog.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/export-catalog.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "legacy:build": "node build.mjs",
    "legacy:dev": "node scripts/legacy-dev.mjs",
    "db:migrate:local": "wrangler d1 migrations apply martech-discovery-platform-prod --local",
    "seed:test": "node scripts/seed-test-member.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.155.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  }
}
